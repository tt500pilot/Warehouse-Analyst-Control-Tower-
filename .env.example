# Local Odoo 19 development defaults
ODOO_URL=http://localhost:8069
ODOO_DB=scm_os_demo
ODOO_USERNAME=admin
ODOO_PASSWORD=change-me
ODOO_ALLOW_INSECURE_HTTP=true

# Optional connection tuning
ODOO_TIMEOUT_SECONDS=20
ODOO_MAX_RETRIES=3
ODOO_RETRY_BACKOFF_SECONDS=0.75
# ODOO_CA_BUNDLE=C:\\path\\to\\company-ca.pem
